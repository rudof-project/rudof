prefix : <http://example.org/>
prefix schema: <http://schema.org/>
prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

:a a :Person ;
   schema:name  "Alice" ;
   :status      :Active ;
   schema:knows :a, :b  .

:b a :Person ;
   schema:name  "Bob"    ;
   :status      :Waiting ;
   schema:knows :c       .

:c a :Person ;
   :status      :Inactive ;
   schema:name  "Carol"  .

:d a :Person ;
   schema:name  23      .  # Should fail
   
:e a :Person ;
   schema:name  "Emily" ;  # Should fail
   schema:knows :d      .
