PREFIX ex: <http://example.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
# A recursive shape: the generator links each person to the next ones, so references
# form long cycles and a failure propagates to every person that reaches it.
ex:PersonShape { a [ex:Person] ; ex:name xsd:string ; ex:knows @ex:PersonShape {1,2} }
