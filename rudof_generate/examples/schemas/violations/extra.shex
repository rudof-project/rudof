PREFIX ex: <http://example.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
# Same constraints with and without EXTRA: an unmatched ex:kind or ex:name value is
# allowed on OpenThing (a trap) and a violation on StrictThing.
ex:OpenShape EXTRA ex:kind ex:name { a [ex:OpenThing] ; ex:kind [ex:A ex:B] ; ex:name xsd:string }
ex:StrictShape { a [ex:StrictThing] ; ex:kind [ex:A ex:B] ; ex:name xsd:string }
