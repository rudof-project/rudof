# facets.pgs in SHACL over its RDF encoding: a pattern and inclusive and exclusive ranges.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix t: <http://rudof.example/pg/type/> .
@prefix k: <http://rudof.example/pg/key/> .
@prefix l: <http://rudof.example/pg/label/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

t:ItemType a sh:NodeShape ; sh:targetClass l:Item ;
  sh:closed true ; sh:ignoredProperties ( rdf:type ) ;
  sh:property [ sh:path k:code ; sh:datatype xsd:string ; sh:pattern "^[A-Z]{3}[0-9]{2}$" ;
                sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path k:price ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxInclusive 500 ;
                sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path k:stock ; sh:datatype xsd:integer ; sh:minExclusive 0 ; sh:maxExclusive 100 ;
                sh:minCount 1 ; sh:maxCount 1 ] .
